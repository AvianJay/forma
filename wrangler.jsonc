{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forma",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api", "/api/*", "/s", "/s/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cv2gen",
    // Replace with the database_id returned by `npx wrangler d1 create cv2gen` before deployment.
    "database_id": "25522ee9-293a-4989-a56f-db4d1cc2b8a4",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{ "name": "WRITE_LIMITER", "namespace_id": "10010918", "simple": { "limit": 10, "period": 60 } }]
}
