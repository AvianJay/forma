{
  "name": "cv2gen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply cv2gen --local",
    "db:remote": "wrangler d1 migrations apply cv2gen --remote",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests *.ts index.html public/media-fallback.js"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "^5.20260917.0-alpha",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  }
}
